# Azure OpenAI / Foundry (required)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT=your-deployment-name

# Azure AI Speech (required) — use keys from your Speech resource in Azure Portal
# Do NOT put comments on the same line as values
AZURE_SPEECH_KEY=your-speech-key-here
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_LANGUAGE=en-US
# Optional comma-separated names/terms to boost recognition
AZURE_SPEECH_PHRASES=

# Optional server
AZURE_OPENAI_API_VERSION=2024-06-01
HOST=0.0.0.0
PORT=8000
MODELS_DIR=./models

# TTS: kokoro (local CPU) or azure (cloud neural)
TTS_BACKEND=kokoro
# Local Kokoro — leave KOKORO_VOICE empty to auto-pick af_heart / af_bella / am_adam
KOKORO_VOICE=af_heart
KOKORO_SPEED=1.05
# Shared speaking rate for UI + TTS (1.0 = normal; used when TTS_SPEED unset)
TTS_SPEED=1.05
# Azure Speech TTS voice when backend=azure (also selectable in the UI)
AZURE_SPEECH_VOICE=en-US-AvaMultilingualNeural

# Barge-in voice activity detection
RMS_SPEECH_START_THRESHOLD=0.035
# Raw mic RMS during agent playback (lower = easier interrupt; pre-amplify)
RMS_BARGE_IN_PLAYBACK_THRESHOLD=0.022
BARGE_IN_SUSTAINED_FRAMES=6
BARGE_IN_VAD_MODE=2
BARGE_IN_VOICED_WINDOW=10
BARGE_IN_VOICED_MIN=6
BARGE_IN_POST_INTERRUPT_SILENCE_FRAMES=30

# STT: silence (ms) before Azure finalizes your utterance (default 800)
STT_SEGMENTATION_SILENCE_MS=800
# Start LLM early after this much local silence following a partial (default 200)
SPECULATIVE_SILENCE_MS=200
