# Azure OpenAI / Foundry (required)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT=your-deployment-name

# Optional server
AZURE_OPENAI_API_VERSION=2024-06-01
HOST=0.0.0.0
PORT=8000
MODELS_DIR=./models

# ASR preview (live captions while speaking)
ASR_PREVIEW_MODEL=small.en
ASR_PREVIEW_BEAM_SIZE=1
ASR_PREVIEW_INTERVAL_SEC=1.0
ASR_PREVIEW_MIN_SECONDS=0.8

# ASR final (higher accuracy after you stop speaking)
ASR_FINAL_MODEL=medium.en
ASR_FINAL_BEAM_SIZE=5

# Shared ASR settings
ASR_CPU_THREADS=4
ASR_COMPUTE_TYPE=int8
# Optional vocabulary hint for names/terms (comma-separated words)
ASR_INITIAL_PROMPT=

# Voice activity detection
FRAME_MS=20
RMS_SPEECH_START_THRESHOLD=0.035
RMS_SPEECH_CONTINUE_THRESHOLD=0.020
PRE_ROLL_MS=300
END_SILENCE_MS=650
MIN_TURN_SECONDS=0.4
