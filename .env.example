# Azure OpenAI / Foundry (required)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT=your-deployment-name

# Azure AI Speech (required) — use keys from your Speech resource in Azure Portal
# Do NOT put comments on the same line as values
AZURE_SPEECH_KEY=your-speech-key-here
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_LANGUAGE=en-US
# Optional comma-separated names/terms to boost recognition
AZURE_SPEECH_PHRASES=

# Optional server
AZURE_OPENAI_API_VERSION=2024-06-01
HOST=0.0.0.0
PORT=8000
MODELS_DIR=./models

# Barge-in voice activity detection
RMS_SPEECH_START_THRESHOLD=0.035
